#!/bin/sh
# Add missing repo permission rules to the live file, stdin -> stdout. Local rules and values are never changed or removed.
# Full defaults only when the live file does not exist yet; an existing (even blank) file is only tightened.
# Always set the flag, so a value exported in the caller's shell can never force a full merge.
PI_DOTFILES_FRESH={{ if stat .chezmoi.targetFile }}0{{ else }}1{{ end }} exec node {{ joinPath .chezmoi.workingTree "scripts/merge-json.mjs" | shellQuote }} permission {{ joinPath .chezmoi.workingTree "agent/permission-system.json" | shellQuote }}
