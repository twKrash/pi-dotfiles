#!/bin/sh
# Git's global ignore file: keeps every existing line and adds the code-gates outputs
# (crapper, dryer and mutator write .metrics/ and target/ into the project root).
awk '
  { print; seen[$0] = 1 }
  END {
    if (!(".metrics/" in seen)) print ".metrics/"
    if (!("target/" in seen)) print "target/"
  }
'
