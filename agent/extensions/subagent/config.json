{
  "toolActivation": "eager",
  "toolDescriptionMode": "compact",
  "inlineToolDisplay": "summary",

  "pinToolDeclarations": true,
  "activeRunsPrompt": true,

  "defaultSubagentContext": "fresh",

  "globalConcurrencyLimit": 4,
  "maxSubagentSpawnsPerSession": 48,
  "maxSubagentSpawnsPerRun": 24,
  "maxActiveAsyncRunsPerSession": 4,

  "parallel": {
    "maxTasks": 6,
    "concurrency": 3
  },

  "maxSubagentDepth": 1,

  "asyncByDefault": true,
  "timeoutMs": 7200000,
  "checkpointBeforeDeadlineMs": 300000,
  "waitTool": {
    "enabled": true,
    "defaultTimeoutMs": 3600000
  },
  "scheduledRuns": {
    "enabled": false
  },

  "fleetView": true,
  "resultScanLogging": "off"
}
