{{- /* Global instructions for one harness: core + harness addendum + this machine's local.md + its local.<harness>.md. */ -}}
{{- $local := joinPath (dir .chezmoi.configFile) "local.md" -}}
{{- $localHarness := joinPath (dir .chezmoi.configFile) (printf "local.%s.md" .harness) -}}
{{- $legacy := joinPath .chezmoi.homeDir ".config/pi-dotfiles/local.md" -}}
{{- if and (stat $legacy) (stat $local) -}}
{{-   fail (printf "both %s (setup.sh) and %s exist: merge the legacy rules into %s, delete %s, then re-run" $legacy $local $local $legacy) -}}
{{- else if stat $legacy -}}
{{-   fail (printf "move %s (setup.sh) to %s, then re-run" $legacy $local) -}}
{{- end -}}
{{- $legacyMemory := joinPath .chezmoi.homeDir ".pi/agent/MEMORY.md" -}}
{{- /* Untouched (stub or blank) old files hold nothing to migrate; anything else must be merged first. */ -}}
{{- if stat $legacyMemory -}}
{{-   $old := include $legacyMemory -}}
{{-   if and (trim $old) (ne $old (include "dot_config/private_ai-memory/create_empty_MEMORY.md")) -}}
{{-     fail (printf "%s is no longer read: merge it into %s, delete it, then re-run" $legacyMemory (joinPath .chezmoi.homeDir ".config/ai-memory/MEMORY.md")) -}}
{{-   end -}}
{{- end -}}
<!-- Generated by chezmoi from pi-dotfiles for {{ .harness }}. Edit instructions/core.md, instructions/harness-{{ .harness }}.md, {{ $local }}, or {{ $localHarness }}, then run chezmoi apply. -->

{{ include "../instructions/core.md" -}}
{{- $addendum := joinPath .chezmoi.workingTree (printf "instructions/harness-%s.md" .harness) -}}
{{- if stat $addendum }}
{{ include $addendum -}}
{{- end -}}
{{- if stat $local }}
{{ include $local -}}
{{- end -}}
{{- if stat $localHarness }}
{{ include $localHarness -}}
{{- end -}}
