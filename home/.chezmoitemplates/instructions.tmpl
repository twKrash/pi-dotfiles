{{- /* Global instructions for one harness: core + harness addendum + this machine's local.md. */ -}}
{{- $local := joinPath (dir .chezmoi.configFile) "local.md" -}}
<!-- Generated by chezmoi from pi-dotfiles for {{ .harness }}. Edit instructions/core.md, instructions/harness-{{ .harness }}.md, or {{ $local }}, then run chezmoi apply. -->

{{ include "../instructions/core.md" -}}
{{- $addendum := joinPath .chezmoi.workingTree (printf "instructions/harness-%s.md" .harness) -}}
{{- if stat $addendum }}
{{ include $addendum -}}
{{- end -}}
{{- if stat $local }}
{{ include $local -}}
{{- end -}}
