{
  "debugLog": true,
  "permissionReviewLog": true,
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "allow",
      "*.env.example": "allow"
    },
    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "bash": {
      "*": "allow",
      "rm -rf *": "ask",
      "sudo *": "ask",
      "git push *": "ask",
      "git push": "ask",
      "git reset --hard": "ask",
      "git reset --hard *": "ask",
      "git clean -f": "ask",
      "git clean -d -f*": "ask",
      "git clean -fd*": "ask"
    },

    "external_directory": {
      "*": "ask",
      "~/.pi/agent/git/github.com/*": "allow",
      "~/.pi/agent/npm/node_modules/*/skills/*": "allow",
      "~/.pi/agent/npm/node_modules/pi-subagents/*": "allow",
      "~/.pi/agent/sessions/*/subagent-artifacts/*": "allow",
      "~/.pi/agent/skills/*": "allow",
      "~/.pi/agent/session-inspector/*": "allow",
      "~/.herdr/*": "allow",
      "/tmp/*": "allow",
      "/tmp": "allow",
      "~/.pi/agent/AGENTS.md": "allow",
      "~/.config/ai-memory/MEMORY.md": "allow"
    },

    "external_directory_read": {
      "~/.pi/agent/sessions/*/subagent-artifacts/*": "allow",
      "~/.pi/*": "allow",
      "/tmp/*": "allow",
      "~/.herdr/*": "allow",
      "~/.agents/*": "allow",
      "~/.codex/plugins/*": "allow",
      "~/.pi/agent/AGENTS.md": "allow",
      "~/.config/ai-memory/*": "allow"
    },
    "external_directory_write": {
      "/tmp/*": "allow",
      "~/.herdr/*": "allow",
      "~/.cache/graphify-queries.log": "allow",
      "~/.pi/agent/sessions/*/subagent-artifacts/*": "allow",
      "~/.pi/tmp/*": "allow",
      "~/.config/ai-memory/MEMORY.md": "allow"
    },
    "skill": {
      "*": "allow",
      "graphify": "allow"
    }
  }
}
